<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--   WINDOW ACTIONS                             -->
    <!-- ============================================ -->

    <!-- Main Action: Overdraft Interest Records -->
    <record id="action_overdraft_interest" model="ir.actions.act_window">
        <field name="name">Overdraft Interest</field>
        <field name="res_model">overdraft.interest</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_overdraft_interest_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Overdraft Interest Record
            </p>
            <p>Track your bank overdraft accounts, calculate daily interest
            and penalties automatically.</p>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   MENU STRUCTURE                             -->
    <!-- ============================================ -->

    <!-- Root Menu -->
    <menuitem id="menu_overdraft_root"
              name="Overdraft Interest"
              sequence="10"
              web_icon="overdraft_interest_calculator,static/description/icon.png"/>

    <!-- Submenu: Overdraft Interest Records -->
    <menuitem id="menu_overdraft_records"
              name="Overdraft Interest"
              parent="menu_overdraft_root"
              action="action_overdraft_interest"
              sequence="10"/>
</odoo>
