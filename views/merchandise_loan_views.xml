<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--   MERCHANDISE LOAN — LIST VIEW               -->
    <!-- ============================================ -->
    <record id="view_merchandise_loan_list" model="ir.ui.view">
        <field name="name">merchandise.loan.list</field>
        <field name="model">merchandise.loan</field>
        <field name="arch" type="xml">
            <list string="Merchandise Loans">
                <field name="name" string="Reference"/>
                <field name="bank_id" string="Bank"/>
                <field name="product_id" string="Goods"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="goods_quantity" string="Qty"/>
                <field name="total_goods_value" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="company_coverage_percent" string="Deposit %" widget="percentage"/>
                <field name="bank_amount" string="Bank Loan" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="outstanding_loan" string="Outstanding" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="goods_held_qty" string="Held (Qty)"/>
                <field name="product_category" optional="show"/>
                <field name="goods_location" optional="hide"/>
                <field name="is_dead_stock_risk" optional="hide" widget="boolean_toggle"/>
                <field name="sales_status" widget="badge" optional="show"
                       decoration-info="sales_status == 'unsold'"
                       decoration-warning="sales_status == 'reserved'"
                       decoration-primary="sales_status == 'partially_sold'"
                       decoration-success="sales_status == 'sold'"
                       decoration-muted="sales_status == 'slow_moving'"
                       decoration-danger="sales_status == 'dead_stock'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-primary="state == 'approved'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   MERCHANDISE LOAN — FORM VIEW               -->
    <!-- ============================================ -->
    <record id="view_merchandise_loan_form" model="ir.ui.view">
        <field name="name">merchandise.loan.form</field>
        <field name="model">merchandise.loan</field>
        <field name="arch" type="xml">
            <form string="Merchandise Loan">
                <header>
                    <button name="action_submit"
                            string="Submit for Approval"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state != 'submitted'"
                            groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            invisible="state != 'active'"
                            groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('submitted',)"
                            groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,active,closed"/>
                    <button name="action_create_bill"
                            string="Create Bill"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('active',)"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book">
                            <field name="move_count" widget="statinfo"
                                   string="Journal Entries"/>
                        </button>
                        <button name="action_view_bills"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="bill_count" widget="statinfo"
                                   string="Bills"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Reference"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"
                               readonly="state in ('approved', 'active', 'closed')"/>
                    </group>

                    <!-- Loan Setup -->
                    <group>
                        <group string="Goods Details">
                            <field name="bank_journal_id"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="bank_id"/>
                            <field name="product_id"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="goods_quantity"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="goods_unit_price" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="goods_selling_price" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="total_goods_value" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="warehouse_id"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="currency_id"
                                   readonly="state in ('approved', 'active', 'closed')"
                                   groups="base.group_multi_currency"/>
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                        </group>
                        <group string="Coverage &amp; Interest">
                            <field name="company_coverage_percent"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="bank_coverage_percent" readonly="1"/>
                            <field name="company_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="bank_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="annual_interest_rate"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="date_from"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="date_to"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="activation_date" readonly="1"
                                   invisible="not activation_date"/>
                        </group>
                    </group>

                    <!-- Penalty Rates -->
                    <group>
                        <group string="Penalty Rates">
                            <field name="penalty_rate_tier1" string="Days 1–30 (% p.a.)"/>
                            <field name="penalty_rate_tier2" string="Days 31–60 (% p.a.)"/>
                            <field name="penalty_rate_tier3" string="Days 60+ (% p.a.)"/>
                        </group>
                    </group>

                    <!-- Trade & Merchandise Details -->
                    <group>
                        <group string="Trade &amp; Merchandise Details">
                            <field name="product_category"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="goods_location"
                                   readonly="state == 'closed'"/>
                            <field name="sales_status"
                                   readonly="state == 'closed'"/>
                        </group>
                        <group string="Import Documentation">
                            <field name="import_document_type"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                            <field name="import_document_number"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                        </group>
                    </group>
                    <group>
                        <group string="Goods Description" colspan="2">
                            <field name="goods_description"
                                   placeholder="Detailed description of the financed merchandise: specifications, model, type, or quality…"
                                   nolabel="1"
                                   colspan="2"
                                   readonly="state in ('approved', 'active', 'closed')"/>
                        </group>
                    </group>

                    <!-- Account Fields -->
                    <group>
                        <group string="Account Entries">
                            <field name="account_receivable_id"
                                   readonly="state == 'closed'"/>
                            <field name="account_payable_id"
                                   readonly="state == 'closed'"/>
                        </group>
                        <group string="Account Properties">
                            <field name="income_account_id"
                                   readonly="state == 'closed'"/>
                            <field name="expense_account_id"
                                   readonly="state == 'closed'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Summary Tab -->
                        <page string="Summary">
                            <group>
                                <group string="Loan Status">
                                    <field name="outstanding_loan" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="total_paid" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="total_interest" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="penalty_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                                <group string="Goods Status">
                                    <field name="goods_held_qty" readonly="1"
                                           string="Goods Held by Bank (Qty)"/>
                                    <field name="total_goods_released_qty" readonly="1"
                                           string="Goods Released (Qty)"/>
                                    <field name="goods_owned_by_company" readonly="1"
                                           string="Goods Owned by Company (Qty)"/>
                                </group>
                            </group>
                            <group>
                                <group string="Costing">
                                    <field name="interest_per_unit" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="actual_unit_cost" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="margin_per_unit" widget="monetary"
                                           options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                                <group string="Sales &amp; Ageing">
                                    <field name="days_held" readonly="1"/>
                                    <field name="is_dead_stock_risk" readonly="1" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>

                        <!-- Goods Release Entries Tab -->
                        <page string="Goods Release Entries">
                            <field name="loan_line_ids"
                                   readonly="state not in ('active',)">
                                <list string="Goods Release Entries" create="true" delete="true" editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="date" string="Date"/>
                                    <field name="goods_released_quantity"
                                           string="Goods Qty to Release"/>
                                    <field name="goods_value" string="Goods Value"
                                           widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="payment_amount" string="Payment Amount"
                                           widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="interest" string="Interest Portion"
                                           widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="penalty" string="Penalty Portion"
                                           widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="outstanding_after" string="Outstanding After"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="notes" string="Notes"/>
                                </list>
                            </field>
                        </page>

                        <!-- Purpose & Collateral Tab -->
                        <page string="Purpose &amp; Collateral">
                            <group>
                                <group string="Loan Purpose" colspan="2">
                                    <field name="purpose"
                                           placeholder="Describe the intended use (e.g. import of plastic raw materials for packaging)…"
                                           nolabel="1"
                                           colspan="2"
                                           required="1"/>
                                </group>
                            </group>
                            <separator string="Collateral Documents"/>
                            <field name="collateral_document_ids"
                                   widget="many2many_binary"
                                   string="Attach Collateral Documents"
                                   required="1"/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   MERCHANDISE LOAN — GRAPH VIEW              -->
    <!-- ============================================ -->
    <record id="view_merchandise_loan_graph" model="ir.ui.view">
        <field name="name">merchandise.loan.graph</field>
        <field name="model">merchandise.loan</field>
        <field name="arch" type="xml">
            <graph string="Merchandise Loans" type="bar">
                <field name="bank_id" type="row"/>
                <field name="bank_amount" type="measure"/>
                <field name="outstanding_loan" type="measure"/>
                <field name="total_paid" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   MERCHANDISE LOAN — PIVOT VIEW              -->
    <!-- ============================================ -->
    <record id="view_merchandise_loan_pivot" model="ir.ui.view">
        <field name="name">merchandise.loan.pivot</field>
        <field name="model">merchandise.loan</field>
        <field name="arch" type="xml">
            <pivot string="Merchandise Loans">
                <field name="bank_id" type="row"/>
                <field name="product_category" type="row"/>
                <field name="state" type="col"/>
                <field name="bank_amount" type="measure"/>
                <field name="outstanding_loan" type="measure"/>
                <field name="total_paid" type="measure"/>
                <field name="total_interest" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>