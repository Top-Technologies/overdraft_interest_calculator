<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--   OVERDRAFT INTEREST — LIST VIEW             -->
    <!-- ============================================ -->
    <record id="view_overdraft_interest_list" model="ir.ui.view">
        <field name="name">overdraft.interest.list</field>
        <field name="model">overdraft.interest</field>
        <field name="arch" type="xml">
            <list string="Overdraft Interest">
                <field name="name" string="Reference"/>
                <field name="bank_journal_id" string="Bank Journal"/>
                <field name="bank_id" string="Bank"/>
                <field name="date_from" string="Start Date"/>
                <field name="date_to" string="End Date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="overdraft_limit" string="Overdraft Limit"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="current_balance" string="Current Balance"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="total_interest" string="Total Interest"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="show"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   OVERDRAFT INTEREST — FORM VIEW             -->
    <!-- ============================================ -->
    <record id="view_overdraft_interest_form" model="ir.ui.view">
        <field name="name">overdraft.interest.form</field>
        <field name="model">overdraft.interest</field>
        <field name="arch" type="xml">
            <form string="Overdraft Interest">
                <!-- Workflow Buttons -->
                <header>
                    <!-- Calculate / Recalculate Amortization Button -->
                    <button name="action_calculate_amortization"
                            string="Calculate Amortization"
                            type="object"
                            class="oe_highlight"
                            invisible="is_calculated or state == 'closed'"/>
                    <button name="action_calculate_amortization"
                            string="Recalculate Amortization"
                            type="object"
                            class="oe_highlight"
                            invisible="not is_calculated or state == 'closed'"/>

                    <button name="action_submit"
                            string="Submit for Approval"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="overdraft_interest_calculator.group_overdraft_manager"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state != 'submitted'"
                            groups="overdraft_interest_calculator.group_overdraft_manager"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('rejected', 'submitted')"
                            groups="overdraft_interest_calculator.group_overdraft_manager"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            invisible="state != 'approved'"
                            groups="overdraft_interest_calculator.group_overdraft_manager"/>
                    <button name="action_reopen"
                            string="Revert to Approved (Test)"
                            type="object"
                            invisible="state != 'closed'"
                            groups="overdraft_interest_calculator.group_overdraft_manager"/>
                    <button name="action_create_bill"
                            string="Create Bill"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('approved',)"/>
                    <button name="action_record_payment"
                            string="Record Payment"
                            type="object"
                            invisible="state not in ('approved',)"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,closed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book">
                            <field name="move_count" widget="statinfo"
                                   string="Journal Entries"/>
                        </button>
                        <button name="action_view_bills"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="bill_count" widget="statinfo"
                                   string="Bills"/>
                        </button>
                    </div>
                    <!-- Reference Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Reference"/>
                        </h1>
                    </div>

                    <!-- Main Fields - Two Columns -->
                    <group>
                        <group string="Bank Details">
                            <field name="bank_journal_id"
                                   options="{'no_create': True}"
                                   readonly="state in ('approved', 'closed')"/>
                            <field name="bank_id" readonly="1" force_save="1"/>
                            <field name="od_account_number"
                                   readonly="state in ('approved', 'closed')"
                                   placeholder="e.g. 1000123456789"/>
                            <field name="date_from" string="Start Date"
                                   readonly="state in ('approved', 'closed')"/>
                            <field name="date_to" string="End Date"
                                   readonly="state in ('approved', 'closed')"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Rates &amp; Limits">
                            <field name="annual_interest_rate"
                                   string="Annual Interest Rate (%)"
                                   readonly="state == 'closed'"/>
                            <field name="annual_penalty_rate"
                                   string="Annual Penalty Rate (%)"
                                   readonly="state == 'closed'"/>
                            <field name="overdraft_limit"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="state in ('approved', 'closed')"/>
                            <field name="is_calculated" invisible="1"/>
                        </group>
                    </group>

                    <!-- Account Fields -->
                    <group>
                        <group string="Account Entries">
                            <field name="account_receivable_id"
                                   readonly="state == 'closed'"/>
                            <field name="account_payable_id"
                                   readonly="state == 'closed'"/>
                        </group>
                        <group string="Account Properties">
                            <field name="income_account_id"
                                   readonly="state == 'closed'"/>
                            <field name="expense_account_id"
                                   readonly="state == 'closed'"/>
                        </group>
                    </group>

                    <!-- Tabs -->
                    <notebook>
                        <!-- Tab 1: Daily Entries -->
                        <page string="Daily Entries">
                            <field name="overdraft_line_ids">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="date" string="Date" readonly="1"/>
                                    <field name="debit" string="Debit"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="payment" string="Payment"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="balance" string="Balance"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="daily_interest" string="Daily Interest"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="penalty" string="Extra Interest"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="cumulative_interest" string="Cumulative Interest"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 2: Summary -->
                        <page string="Summary">
                            <group>
                                <group string="Facility Status">
                                    <field name="overdraft_limit"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="current_utilization" string="Current Utilization"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="available_balance" string="Available Balance"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                </group>
                                <group string="Interest &amp; Cost">
                                    <field name="total_interest" string="Total Interest"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="total_penalty" string="Total Penalty"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="interest_charged" string="Interest Charged (Period)"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Cash Flow">
                                    <field name="total_debit" string="Total Debit"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="total_payment" string="Total Payment"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="current_balance" string="Current Balance"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Purpose & Collateral -->
                        <page string="Purpose &amp; Collateral">
                            <group>
                                <group string="Facility Purpose" colspan="2">
                                    <field name="purpose"
                                           placeholder="Describe the intended use of this overdraft facility…"
                                           nolabel="1"
                                           colspan="2"/>
                                </group>
                            </group>
                            <separator string="Collateral / Security Documents"/>
                            <field name="collateral_document_ids"
                                   widget="many2many_binary"
                                   string="Attach Collateral / Security Documents"/>
                        </page>
                    </notebook>

                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   STATUS DASHBOARD — LIST VIEW               -->
    <!--   (kept to update orphaned DB record)        -->
    <!-- ============================================ -->
    <record id="view_overdraft_status_list" model="ir.ui.view">
        <field name="name">overdraft.interest.status.list</field>
        <field name="model">overdraft.interest</field>
        <field name="arch" type="xml">
            <list string="Overdraft Status" create="false" edit="false" delete="false">
                <field name="name" string="Reference"/>
                <field name="bank_journal_id" string="Bank Journal"/>
                <field name="date_to" string="End Date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_interest" string="Total Interest"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="total_penalty" string="Total Penalty"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="current_balance" string="Current Balance"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>
</odoo>
