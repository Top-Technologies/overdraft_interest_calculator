<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--   OVERDRAFT LINE — LIST VIEW                -->
    <!-- ============================================ -->
    <record id="view_overdraft_line_list" model="ir.ui.view">
        <field name="name">overdraft.line.list</field>
        <field name="model">overdraft.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Overdraft Entries">
                <field name="currency_id" column_invisible="1"/>
                <field name="date" string="Date"/>
                <field name="amount" string="Amount"/>
                <field name="interest" string="Interest"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1" force_save="1"/>
                <field name="penalty" string="Penalty"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="payment" string="Payment"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="total_balance" string="Total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"/>
                <field name="remaining_balance" string="Remaining"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"/>
            </list>
        </field>
    </record>
</odoo>
