<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--   OVERDRAFT LINE — LIST VIEW (standalone)   -->
    <!-- ============================================ -->
    <record id="view_overdraft_line_list" model="ir.ui.view">
        <field name="name">overdraft.line.list</field>
        <field name="model">overdraft.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Overdraft Daily Entries">
                <field name="currency_id" column_invisible="1"/>
                <field name="date" string="Date"/>
                <field name="debit" string="Debit"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="payment" string="Payment"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"/>
                <field name="balance" string="Balance"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"/>
                <field name="daily_interest" string="Daily Interest"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"/>
                <field name="penalty" string="Extra Interest"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="cumulative_interest" string="Cumulative Interest"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"/>
            </list>
        </field>
    </record>
</odoo>
