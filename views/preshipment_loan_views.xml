<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--   PRE-SHIPMENT LOAN — LIST VIEW              -->
    <!-- ============================================ -->
    <record id="view_preshipment_loan_list" model="ir.ui.view">
        <field name="name">preshipment.loan.list</field>
        <field name="model">preshipment.loan</field>
        <field name="arch" type="xml">
            <list string="Pre-Shipment Loans">
                <field name="name" string="Reference"/>
                <field name="bank_id" string="Bank"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="loan_amount" string="Loan Amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="foreign_currency_id" string="FC"/>
                <field name="total_currency_to_store" string="Currency to Store"/>
                <field name="currency_fulfillment_percent" string="Fulfillment %" widget="percentage"/>
                <field name="start_date" string="Start"/>
                <field name="end_date" string="End Date" optional="show"/>
                <field name="expected_export_date" string="Export Date"/>
                <field name="outstanding_balance" string="Outstanding" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="penalty_amount" string="Penalty" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   PRE-SHIPMENT LOAN — FORM VIEW              -->
    <!-- ============================================ -->
    <record id="view_preshipment_loan_form" model="ir.ui.view">
        <field name="name">preshipment.loan.form</field>
        <field name="model">preshipment.loan</field>
        <field name="arch" type="xml">
            <form string="Pre-Shipment Loan">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'submitted'" groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'active'" groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('rejected', 'submitted')" groups="overdraft_interest_calculator.group_overdraft_editor"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,active,closed"/>
                    <button name="action_create_bill" string="Create Bill" type="object" class="oe_highlight" invisible="state not in ('active',)"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="action_view_bills" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="bill_count" widget="statinfo" string="Bills"/>
                        </button>
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not sale_order_count">
                            <field name="sale_order_count" widget="statinfo" string="Sales Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Reference"/>
                        </h1>
                    </div>

                    <group>
                        <field name="company_id" groups="base.group_multi_company"
                               readonly="state != 'draft'"/>
                    </group>
                    <!-- Loan & Export Details -->
                    <group>
                        <group string="Loan Details">
                            <field name="bank_journal_id" readonly="state != 'draft'"/>
                            <field name="bank_id"/>
                            <field name="loan_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
                            <field name="annual_interest_rate" readonly="state != 'draft'"/>
                            <field name="penalty_rate_tier1" string="Penalty Rate — Days 1–30 (% p.a.)"/>
                            <field name="penalty_rate_tier2" string="Penalty Rate — Days 31–60 (% p.a.)"/>
                            <field name="penalty_rate_tier3" string="Penalty Rate — Days 60+ (% p.a.)"/>
                            <field name="currency_id" readonly="state != 'draft'" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Foreign Currency Commitment">
                            <field name="foreign_currency_id" readonly="state != 'draft'"/>
                            <field name="total_currency_to_store" readonly="state != 'draft'"/>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="expected_export_date" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- Sales Orders -->
                    <group>
                        <group string="Linked Sales Orders" colspan="2">
                            <field name="sale_order_ids" nolabel="1" colspan="2">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- Raw Material Financed -->
                    <group>
                        <group string="Raw Material Financed">
                            <field name="raw_material_description" readonly="state != 'draft'"/>
                            <label for="raw_material_qty"/>
                            <div class="o_row">
                                <field name="raw_material_qty" readonly="state != 'draft'"/>
                                <field name="raw_material_uom_id" readonly="state != 'draft'"/>
                            </div>
                            <field name="raw_material_value" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- Account Fields -->
                    <group>
                        <group string="Account Entries">
                            <field name="account_receivable_id" readonly="state != 'draft'"/>
                            <field name="account_payable_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Account Properties">
                            <field name="income_account_id" readonly="state != 'draft'"/>
                            <field name="expense_account_id" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Summary Tab -->
                        <page string="Summary">
                            <group>
                                <group string="Loan Usage">
                                    <field name="loan_used" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="loan_remaining" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="total_interest" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="penalty_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                                <group string="Currency Fulfillment">
                                    <field name="currency_stored" readonly="1"/>
                                    <field name="currency_remaining" readonly="1"/>
                                    <field name="currency_fulfillment_percent" widget="percentage" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Export Proceeds &amp; Settlement">
                                    <field name="export_proceeds_foreign_amount" readonly="1"/>
                                    <field name="export_proceeds_local_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="loan_settled_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="company_remaining_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="outstanding_balance" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Entries Tab -->
                        <page string="Utilisation &amp; Currency Entries">
                            <field name="loan_line_ids">
                                <list string="Entries">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="foreign_currency_id" column_invisible="1"/>
                                    <field name="date"/>
                                    <field name="entry_type"/>
                                    <field name="amount_used" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Used"/>
                                    <field name="currency_deposited" sum="Total Deposited"/>
                                    <field name="conversion_rate" optional="show"/>
                                    <field name="amount_deposited_local" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" sum="Total Deposited (Local)"/>
                                    <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </list>
                                <form string="Entry">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="currency_id" invisible="1"/>
                                                <field name="foreign_currency_id" invisible="1"/>
                                                <field name="entry_type" widget="radio" readonly="id"/>
                                                <field name="date"/>
                                            </group>
                                        </group>
                                        <group string="Utilization Details" invisible="entry_type != 'utilization'">
                                            <group>
                                                <field name="currency_id" string="Local Currency" readonly="1"/>
                                                <field name="amount_used" required="entry_type == 'utilization'"/>
                                                <field name="interest" readonly="1"/>
                                                <field name="total_amount" readonly="1"/>
                                            </group>
                                        </group>
                                        <group string="Foreign Currency Details" invisible="entry_type != 'currency'">
                                            <group>
                                                <field name="foreign_currency_id" string="Foreign Currency" readonly="1"/>
                                                <field name="currency_deposited" required="entry_type == 'currency'"/>
                                                <field name="conversion_rate" required="entry_type == 'currency'"/>
                                                <field name="amount_deposited_local" readonly="1"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="notes" placeholder="Additional notes..."/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <!-- Purpose & Collateral Tab -->
                        <page string="Purpose &amp; Collateral">
                            <group>
                                <group string="Loan Purpose" colspan="2">
                                    <field name="purpose" placeholder="Describe the intended use (e.g. sesame procurement for export to Israel)…" nolabel="1" colspan="2" required="1"/>
                                </group>
                            </group>
                            <separator string="Collateral Documents"/>
                            <field name="collateral_document_ids" widget="many2many_binary" string="Attach Collateral Documents" required="1"/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   PRE-SHIPMENT LOAN — GRAPH VIEW             -->
    <!-- ============================================ -->
    <record id="view_preshipment_loan_graph" model="ir.ui.view">
        <field name="name">preshipment.loan.graph</field>
        <field name="model">preshipment.loan</field>
        <field name="arch" type="xml">
            <graph string="Pre-Shipment Loans" type="bar">
                <field name="bank_id" type="row"/>
                <field name="loan_amount" type="measure"/>
                <field name="loan_used" type="measure"/>
                <field name="total_interest" type="measure"/>
                <field name="penalty_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================ -->
    <!--   PRE-SHIPMENT LOAN — PIVOT VIEW             -->
    <!-- ============================================ -->
    <record id="view_preshipment_loan_pivot" model="ir.ui.view">
        <field name="name">preshipment.loan.pivot</field>
        <field name="model">preshipment.loan</field>
        <field name="arch" type="xml">
            <pivot string="Pre-Shipment Loans">
                <field name="bank_id" type="row"/>
                <field name="state" type="col"/>
                <field name="loan_amount" type="measure"/>
                <field name="loan_used" type="measure"/>
                <field name="loan_remaining" type="measure"/>
                <field name="total_interest" type="measure"/>
                <field name="penalty_amount" type="measure"/>
                <field name="raw_material_value" type="measure"/>
                <field name="outstanding_balance" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>