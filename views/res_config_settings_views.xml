<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--   SETTINGS FORM VIEW                         -->
    <!-- ============================================ -->
    <record id="view_overdraft_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.overdraft</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Overdraft Interest" string="Overdraft Interest" data-key="overdraft_interest_calculator">
                    <block title="Default Rates" name="overdraft_default_rates">
                        <setting id="overdraft_interest_rate_setting" help="Pre-fill the daily interest rate when creating new overdraft records.">
                            <label for="overdraft_default_interest_rate" string="Default Interest Rate (%)"/>
                            <div class="text-muted">
                                Applied to new overdraft records automatically
                            </div>
                            <field name="overdraft_default_interest_rate"/>
                        </setting>
                        <setting id="overdraft_penalty_rate_setting" help="Pre-fill the daily penalty rate when creating new overdraft records.">
                            <label for="overdraft_default_penalty_rate" string="Default Penalty Rate (%)"/>
                            <div class="text-muted">
                                Applied to new overdraft records automatically
                            </div>
                            <field name="overdraft_default_penalty_rate"/>
                        </setting>
                    </block>
                    <block title="General" name="overdraft_general_settings">
                        <setting id="overdraft_grace_period_setting" help="Number of days before penalty starts being applied on overdue overdrafts.">
                            <label for="overdraft_grace_period_days" string="Grace Period (Days)"/>
                            <div class="text-muted">
                                Penalty will not apply within this period
                            </div>
                            <field name="overdraft_grace_period_days"/>
                        </setting>
                        <setting id="overdraft_prefix_setting" help="Customize the prefix for overdraft reference numbers.">
                            <label for="overdraft_sequence_prefix" string="Reference Prefix"/>
                            <div class="text-muted">
                                e.g. OD/ produces OD/0001, OD/0002...
                            </div>
                            <field name="overdraft_sequence_prefix"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Action to open settings -->
    <record id="action_overdraft_config_settings" model="ir.actions.act_window">
        <field name="name">Overdraft Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'overdraft_interest_calculator'}</field>
    </record>
</odoo>
